pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'python3 -m pip install -r requirements.txt'
            }
        }

        stage('Run Tests') {
            steps {
                sh 'python3 -m pytest test_app.py'
            }
        }

        stage('Deploy') {
            steps {
                sh 'pkill -f "python3 app.py" || true'
                sh 'nohup python3 app.py > app.log 2>&1 &'
            }
        }
    }
}