pipeline {
    agent any
    stages {
        stage('Checkout') { steps { checkout scm } }
        stage('Install')  { steps { sh 'mvn clean compile' } }
        stage('Test')     { steps { sh 'mvn test' } }
        stage('Deploy')   { 
            steps { 
                sh 'mvn package'
                sh 'pkill -f "java -jar" || true'
                sh 'nohup java -cp target/todo-app-1.0.jar TodoApp > app.log 2>&1 &'
            } 
        }
    }
}