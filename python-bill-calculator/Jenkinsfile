pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install') {
            steps {
                sh 'python3 -m pip install -r requirements.txt'
            }
        }

        stage('Test') {
            steps {
                sh 'python3 -m pytest test_app.py'
            }
        }

        stage('Deploy') {
            steps {
                sh 'pkill -f "python3 app.py" || true'
                sh 'nohup python3 app.py > app.log 2>&1 &'
            }
        }
    }

    post {
        success {
            echo "SUCCESS: Pipeline deployed successfully! Application active at http://localhost:5000"
        }
        failure {
            echo "ALERT: Pipeline build/test failed! Deployment aborted."
        }
    }
}